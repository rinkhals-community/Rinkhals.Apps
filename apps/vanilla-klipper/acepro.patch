+pid_Kp : 33.536
+pid_Ki : 0.441
+pid_Kd : 634.454
+min_temp : -200
+max_temp : 140  #NTC 采集ADC报错阀值
+
+
+
+[tmc2209 stepper_x]
+uart_pin : PA3
+uart_address : 3
+run_current : 1.5
+hold_current:0.75
+sense_resistor: 0.0750
+stealthchop_threshold :0
+interpolate : True
+driver_SGTHRS: 80
+diag_pin: PA6
+driver_MULTISTEP_FILT: False
+
+[tmc2209 stepper_y]
+uart_pin : PA3
+uart_address : 1
+run_current : 1.5
+hold_current:0.75
+sense_resistor: 0.075
+stealthchop_threshold :0
+interpolate : True
+driver_SGTHRS: 80
+diag_pin: PA12
+driver_MULTISTEP_FILT: False
+
+[tmc2209 stepper_z]
+uart_pin : PA3
+uart_address : 2
+run_current : 1.6
+hold_current:0.8
+sense_resistor: 0.0750
+stealthchop_threshold : 0
+interpolate : True
+driver_MULTISTEP_FILT: False
+
+[tmc2209 extruder]
+uart_pin : nozzle_mcu:PA3
+uart_address : 3
+run_current : 0.6
+hold_current:0.3
+sense_resistor: 0.075
+stealthchop_threshold : 99999
+interpolate : True
+driver_SEMIN:15
+driver_SEUP:3
+driver_SEMAX:15
+driver_SEDN:3
+driver_SEIMIN:1
+driver_MULTISTEP_FILT: False
+
+# [safe_z_home]
+# home_xy_position: 125,125
+# speed: 120
+# z_hop: 4.0
+# z_hop_speed: 8.0
+
+[idle_timeout] 
+timeout: 3600
+gcode:
+    {% if printer.pause_resume.is_paused %}
+        M118 Bypassed Timeout
+        M117 Bypassed Timeout
+    {% else %}
+        M118 Timeout Reached
+        M117 Timeout Reached
+        TURN_OFF_HEATERS
+        M84
+    {% endif %}
+
+[homing_override]
+axes: xyz
+gcode:
+  {% set REQX = 'X' in params or 'x' in params %}
+  {% set REQY = 'Y' in params or 'y' in params %}
+  {% set REQZ = 'Z' in params or 'z' in params %}
+  {% if not REQX and not REQY and not REQZ %}
+    {% set REQX = True %}{% set REQY = True %}{% set REQZ = True %}
+  {% endif %}
+
+  {% set CENTER_X = 125 %}
+  {% set CENTER_Y = 125 %}
+  {% set XY_FEED  = 120*60 %}   # 120 mm/s -> 7200 mm/min
+  {% set Z_HOP    = 6 %}
+  {% set Z_HOP_F  = 8*60 %}     # 8 mm/s  -> 480 mm/min
+
+  # Save state so feedrate doesn't leak out after homing
+  SAVE_GCODE_STATE NAME=homing_state
+
+  {% if 'z' not in printer.toolhead.homed_axes %}
+      # Lift requires a homed Z; fake it to allow the safety hop before real homing
+      SET_KINEMATIC_POSITION Z=0
+      G91
+      G0 Z{Z_HOP} F{Z_HOP_F}
+      G90
+  {% endif %}
+
+  {% set need_y = REQY or (REQX and 'y' not in printer.toolhead.homed_axes) or (REQZ and 'y' not in printer.toolhead.homed_axes) %}
+  {% set need_x = REQX or (REQZ and 'x' not in printer.toolhead.homed_axes) %}
+
+  {% if need_y %} G28 Y {% endif %}
+  {% if need_x %} G28 X {% endif %}
+
+  # ---- if Z is requested, ensure XY are homed (for G28 Z alone cases)
+  {% if REQZ %}
+    {% if 'y' not in printer.toolhead.homed_axes %} G28 Y {% endif %}
+    {% if 'x' not in printer.toolhead.homed_axes %} G28 X {% endif %}
+
+    # move to safe center and home Z (probe)
+    G0 X{CENTER_X} Y{CENTER_Y} F{XY_FEED}
+    G28 Z
+    G91
+    G0 Z{Z_HOP} F{Z_HOP_F}
+    G90    
+  {% endif %}
+
+  # Restore feedrate so it doesn't leak F480 to subsequent commands
+  RESTORE_GCODE_STATE NAME=homing_state MOVE=0
+
+
+[verify_heater extruder]
+max_error: 120
+check_gain_time:30
+hysteresis: 5
+heating_gain:1
+
+[verify_heater heater_bed]
+max_error: 120
+check_gain_time:300
+hysteresis: 5
+heating_gain:1
+
+
+[controller_fan controller_fan]
+pin : PB5
+fan_speed : 1
+idle_speed: 0
+idle_timeout: 30
+
+[heater_fan extruder_fan]
+pin : nozzle_mcu:PB9
+#tachometer_pin:nozzle_mcu:PB5
+
+[fan]
+pin : nozzle_mcu:PB6
+cycle_time:0.005
+#tachometer_pin :nozzle_mcu:PB7
+hardware_pwm: True
+
+[fan_generic box_fan]
+pin : PC6
+cycle_time: 0.00003333333
+hardware_pwm: True
+#1：  3%    2:5%   3:7%  4：10%   5:12%  6:14%  7:20%  8:28%   9:45%  10:100%
+#pwm_table:0.0,0.0  ,0.1,0.03  ,0.2,0.05 ,0.3,0.07  ,0.4,0.1  ,0.5,0.12  ,0.6,0.14  ,0.7,0.20  ,0.8,0.28  ,0.9,0.45  ,1.00,1.00
+
+[fan_generic air_filter_fan]
+pin : PC7
+cycle_time: 0.00003333333
+hardware_pwm: True
+
+#[led_pin]
+#gpio:117
+
+#[output_pin power_pin]
+#pin:PB4
+#value:1
+#shutdown_value:0
+
+[lis2dw12]
+spi_speed: 1000000
+cs_pin: nozzle_mcu:PB12
+spi_software_sclk_pin:nozzle_mcu:PB13
+spi_software_mosi_pin:nozzle_mcu:PB15
+spi_software_miso_pin:nozzle_mcu:PB14
+rate: 400
+axes_map:x,z,y
+
+[resonance_tester]
+accel_chip: lis2dw12
+probe_points:127, 127, 20
+min_freq: 1
+max_freq: 140
+accel_per_hz: 150
+hz_per_sec:  2 #max 2 allowed, orig AC was 4
+#test_freq_start: 70
+#test_freq_end: 80
+
+[gcode_arcs]
+resolution:1.0
+
+[input_shaper]
+shaper_freq_x: 60.0
+shaper_freq_y: 60.0
+shaper_type_x: mzv
+shaper_type_y: mzv
+
+[exclude_object]
+
+[force_move]
+enable_force_move: True
+
+[stepper_enable]
+
+# Actually not a filament sensor, but a switch for the filament cutter
+# True=Cutter engaged
+# [filament_switch_sensor filament_cutter]
+# pause_on_runout: False
+# #runout_gcode:
+# #insert_gcode:
+# event_delay: 3.0
+# pause_delay: 0.5
+# #debounce_delay:
