diff --git a/ace_K3.cfg b/ace_K3.cfg
new file mode 100644
index 0000000..466a045
--- /dev/null
+++ b/ace_K3.cfg
@@ -0,0 +1,187 @@
+######################################################################
+# Include Generic ACE Macros
+######################################################################
+# Generic macros shared between all printer types are in ace_macros_generic.cfg
+# Expected supporting macros (provided by printer/printer_generic_macros):
+# - CUT_TIP
+# - TO_THROW_POSITION
+# - RESUME_NOZZLE_WIPE_SEQUENCE
+# - FLUSH_POOP
+# - _PAUSE_RESUME_STATE (optional; guarded)
+[include ace_macros_generic.cfg]
+
+######################################################################
+# Custom Tool Macros (Optional - For Spoolman/Extensions)
+######################################################################
+# ACE automatically detects custom T<n> macros and skips auto-registration.
+# Use this for integrations like Spoolman: https://github.com/Donkie/Spoolman
+#
+# Example: Custom T0 macro with Spoolman integration
+# [gcode_macro T0]
+# gcode:
+#     SET_ACTIVE_SPOOL ID=1
+#     ACE_CHANGE_TOOL TOOL=0
+#
+# Example: Custom T1 macro
+# [gcode_macro T1]
+# gcode:
+#     SET_ACTIVE_SPOOL ID=2
+#     ACE_CHANGE_TOOL TOOL=1
+######################################################################
+# Please check that [save_variables] is above [ace] if you're using different config
+[save_variables]
+filename: ~/printer_data/config/saved_variables.cfg
+
+# Workaround to get an on/off switch to toggle between ACE Pro and external spool printing
+[virtual_pins]
+
+[output_pin ACE_Pro]
+pin: virtual_pin:ace_pro
+pwm: False
+value: 1
+shutdown_value: 0
+
+# Dashboard slider for tangle detection (see [ace] section below).
+# Enabled by default — comment out this block to remove the Mainsail/Fluidd
+# toggle. When configured the slider is authoritative — the
+# ACE_TANGLE_DETECTION command and the in-prompt "Disable Detection &
+# Resume" button flip the pin so the dashboard stays in sync with the
+# runtime state.
+[output_pin TANGLE_DETECTION]
+pin: virtual_pin:tangle_detection
+pwm: False
+value: 1
+shutdown_value: 0
+
+[respond]
+
+[ace]
+ace_count: 1
+baud: auto            # auto = 115200 for ACE1, 230400 for ACE2 - always correct
+#protocol: auto       # auto = detect from connected USB devices (ace1_json | ace2_proto | auto)
+#Mapping of filament runout sensors in ACE to printer sensors (K3 has no RDM sensor)
+#filament_runout_sensor_name_rdm: filament_runout_rdm
+filament_runout_sensor_name_nozzle: filament_runout_nozzle
+
+# Optional: expose ACE device temperature as a Klipper temperature_sensor
+# Config is defined at the bottom of this file to keep the [ace] section contiguous.
+
+# Default state of feed-assist after ACE connect/re-connect.
+# This controls if ACE automatically starts pushing out filament of the last active slot after startup,
+# unless it detects resistance via the rear buffer-filament sensors and stops.
+feed_assist_active_after_ace_connect: True
+
+# Connection supervision: monitors ACE connection stability and shows dialog/pauses print
+# if connection becomes unstable (6+ reconnects in 3 minutes). Set to False to disable.
+#ace_connection_supervision: True
+
+# Tangle detection (ACE 1 + ACE 2): pauses the print when ACE pumps continuously
+# above tangle_pump_time seconds — i.e. feeding against a blocked spool.
+# (ACE 2 firmware never self-detects tangles during feed assist, so
+# host-side monitoring covers both generations.)
+# A spool running out AT the ACE pumps exactly the same way ("nothing left
+# to push"), so the slot presence state decides the verdict:
+# - slot empty -> runout: print continues on the remaining filament until
+#   the toolhead sensor triggers normal runout/endless-spool handling.
+# - ACE 2 (sensor-live slot state): threshold crossing with a non-empty
+#   slot pauses immediately (~5 s after tangle onset).
+# - ACE 1 (lagging slot state): a crossing opens a tangle_verify_time
+#   verdict window; pumping reaching tangle_pump_time_hard, or the window
+#   expiring with the slot still non-empty, pauses (~8 s after onset).
+# Enabled by default (with the [output_pin TANGLE_DETECTION] dashboard
+# slider above, which is authoritative when present). Toggle live during a
+# print with ACE_TANGLE_DETECTION ENABLE=0/1 or the slider; set to False
+# and comment out the slider block to disable entirely.
+tangle_detection: True
+# Keep tangle_pump_time above ~4 s: ACE 2 firmware's starved-runout assist
+# retry cycles up to ~3.9 s (fw V1.1.31) — lower values sit inside that band.
+# Minimum enforced: 3.0.
+#tangle_pump_time: 5.0
+# ACE 1 verdict window (fallback; its slot 'empty' report arrives ~4 s after
+# the crossing). 0 = pause immediately at the threshold (fastest, but with an
+# occasional early tangle-labeled pause when a spool runs out at the ACE).
+# Tip: printing WITHOUT endless spool? 0 is a good choice - a runout pauses
+# the print anyway, so the early pause costs little. With endless spool ON,
+# keep the window, or false pauses will interrupt the silent automatic swap.
+#tangle_verify_time: 7.0
+# Continuous-pumping hard ceiling: starved pumping is firmware-capped below
+# it (ACE 1 give-up ~5-6 s, ACE 2 ~3.9 s), so reaching it proves a real
+# blockage — pause immediately. Minimum enforced: 6.5.
+#tangle_pump_time_hard: 8.0
+# Fast disconnect pause: pause the print when the ACE feeding the ACTIVE tool
+# is continuously disconnected for this many seconds mid-print.
+# -1 = auto (ACE1: 30s, ACE2: 5s - ACE2 clamps the filament when not feeding,
+# starving the extruder within seconds). 0 disables. Per-instance: "30,1:5".
+#disconnect_pause_timeout: -1
+
+# RFID temperature mode: how to calculate print temp from RFID tag min/max values
+# Options: average (default), min, max
+# Example: RFID tag with extruder_temp: {min: 190, max: 230}
+#   average -> (190 + 230) / 2 = 210°C
+#   min -> 190°C
+#   max -> 230°C
+#rfid_temp_mode: average
+
+# Default feeding speed
+feed_speed: 60
+# Default retraction speed
+retract_speed: 50
+
+# Value must be greater than the tube length, as it will cause an error and pause the print if more than
+# this amount is fed (and toolhead filament sensor has not triggered).
+total_max_feeding_length: 2600
+
+# Tube length between filament detection sensor on toolhead and ACE filament parking position
+# (where filament is automatically fed by ACE when a new spool is inserted).
+# This is the distance filament needs to be retracted to free the path for other filament.
+# Should be slightly greater than actual tube length.
+parkposition_to_toolhead_length: 115
+parkposition_to_rdm_length: 0
+
+# Length of filament (after extruder_feeding) to feed from toolhead extruder to nozzle, so it's primed to extrude.
+toolhead_full_purge_length: 60
+toolhead_slow_loading_speed: 6
+toolhead_retraction_speed: 5
+toolhead_retraction_length: 55
+# Should be roughly the length between ACE and the printer's 4-in-1 splitter.
+toolchange_load_length: 3000 
+
+#max_dryer_temperature: 55
+
+# Length and speed to feed from ACE and extrude after toolhead sensor has triggered
+# (to ensure extruder gears have grabbed the filament securely).
+extruder_feeding_length: 45
+extruder_feeding_speed: 4
+
+
+default_color_change_purge_length: 50
+default_color_change_purge_speed: 300
+purge_max_chunk_length: 250
+purge_multiplier: 1.0
+# How much filament to feed incrementally as a retry if initial loading failed
+# (stops if total_max_feeding_length is reached).
+incremental_feeding_length: 100 
+incremental_feeding_speed: 60 
+
+pre_cut_retract_length: 2  # Length to retract before CUT_TIP is called
+
+# Runout sensor debounce: number of consecutive sensor-absent readings required
+# before confirming a filament runout. Filters transient sensor noise/glitches.
+# At the 50ms poll interval: 1 = immediate (no debounce), 3 ≈ 150ms, 5 ≈ 250ms.
+#runout_debounce_count: 1
+
+# Load custom ACE temperature sensor type (used by sensor_type: temperature_ace)
+[temperature_ace]
+
+[temperature_sensor ace_temp]
+sensor_type: temperature_ace
+ace_instance: 0
+min_temp: 0
+max_temp: 70
+
+# Example for a second ACE unit (commented out)
+#[temperature_sensor ace_temp_1]
+#sensor_type: temperature_ace
+#ace_instance: 1
+#min_temp: 0
+#max_temp: 70
