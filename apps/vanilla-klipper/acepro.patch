+                                "dryer_status": dryer_data
+                            }
+                            gcmd.respond_info(f"// {json.dumps(status_info)}")
+                    else:
+                        msg = response.get("msg") if response else "No response"
+                        gcmd.respond_info(f"Instance {inst_num}: Status query failed: {msg}")
