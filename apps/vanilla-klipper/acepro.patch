+[gcode_macro M106]
+rename_existing: M106.1
+description: "M106 with named fan mapping and ignore list"
+gcode:
+    {% set p = params.P|int if params.P is defined else 0 %}
+    {% set s = params.S|int if params.S is defined else 255 %}
+    {% if s < 0 %}
+        {% set s = 0 %}
+    {% elif s > 255 %}
+        {% set s = 255 %}
+    {% endif %}
+
+    ; hardcoded ignore list
+    {% set ignored_ps = [3] %}
+
+    {% if p in ignored_ps %}
+        ; M106: P{p} ignored
+    {% else %}
+        {% if p == 2 %}
+            SET_FAN_SPEED FAN=box_fan SPEED={ s / 255.0 }
+        {% elif p == 3 %}
+            SET_FAN_SPEED FAN=air_filter_fan SPEED={ s / 255.0 }
+        {% elif p == 1 %}
+            ; M106: P1 not mapped
+        {% else %}
+            ; M106: route to default part-cooling fan
+            M106.1 S{s}
+        {% endif %}
+    {% endif %}
+
+[gcode_macro M107]
+rename_existing: M107.1
+description: "M107 off with named fan mapping and ignore list"
+gcode:
+    {% set p = params.P|int if params.P is defined else 0 %}
+
+    ; hardcoded ignore list (must match M106)
+    {% set ignored_ps = [3] %}
+
+    {% if p in ignored_ps %}
+        ; M107: P{p} ignored
+    {% else %}
+        {% if p == 2 %}
+            SET_FAN_SPEED FAN=box_fan SPEED=0
+        {% elif p == 3 %}
+            SET_FAN_SPEED FAN=air_filter_fan SPEED=0
+        {% elif p == 1 %}
+            ; M107: P1 not mapped (heater fan is thermostatic)
+        {% else %}
+            ; M107: turn off default part-cooling fan
+            M107.1
+        {% endif %}
+    {% endif %}
+
+[gcode_macro CANCEL_PRINT]
+description: CANCEL_PRINT
+rename_existing: CANCEL_PRINT_BASE
+gcode:
+    #In case resume was called from CANCEL PROMPT, close the prompt
+    RESPOND TYPE=command MSG=action:prompt_end
+
+    # Clear Power Loss Recovery state to prevent false prompts on restart, if PLR is installed
+    {% if "gcode_macro clear_last_file" in printer %}
+        clear_last_file
+    {% endif %}
+
+    {action_respond_info("ACE[M]: CANCEL_PRINT, lifting Z")}
+    G91
+    G1 Z3 F600
+    G90
+
+    {% if printer["output_pin ACE_Pro"] is defined and printer["output_pin ACE_Pro"].value %}
+        # Set CUT_TIP=0 if unload of current filament is not wanted if ACE is used
+        _ACE_HANDLE_PRINT_END CUT_TIP=1
+    {% else %}
+        {action_respond_info("ACE[M]: ACE Pro disabled. Normal cut sequence")}
+        # Comment the two commands here out if unload of current filament is not wanted if external spool is used
+        CUT_TIP
+        FORCE_MOVE STEPPER="extruder" DISTANCE=-90 VELOCITY=10
+    {% endif %}
+    TO_THROW_POSITION
+
+    M104 S0
+    M140 S0 ; turn off heatbed
+    M106 S0 ; fan off
+    SET_FAN_SPEED FAN=box_fan SPEED=0
+    SET_FAN_SPEED FAN=air_filter_fan SPEED=0
+    M84 # Disable steppers
+    CANCEL_PRINT_BASE
+
+[gcode_macro M204]
+rename_existing: M204.1
+description: M204 that supports single P or T (Anycubic Slicer compatibility)
+gcode:
+  {% set s = params.S|default(None) %}
+  {% set p = params.P|default(None) %}
+  {% set t = params.T|default(None) %}
+
+  {% if s is not none %}
+    # Standard: use S directly
+    SET_VELOCITY_LIMIT ACCEL={s|float}
+
+  {% else %}
+    {% if p is not none and t is not none %}
+      # Standard Klipper semantics: accel = min(P, T)
+      {% if p|float < t|float %}
+        {% set accel = p|float %}
+      {% else %}
+        {% set accel = t|float %}
+      {% endif %}
+      SET_VELOCITY_LIMIT ACCEL={accel}
+
+    {% elif p is not none %}
+      # Non-standard: only P given → accel = P (match Anycubic / Go behaviour)
+      SET_VELOCITY_LIMIT ACCEL={p|float}
+
+    {% elif t is not none %}
+      # Non-standard: only T given → accel = T
+      SET_VELOCITY_LIMIT ACCEL={t|float}
+
+    {% else %}
+      RESPOND PREFIX="M204" MSG="Ignored: no S/P/T specified"
+    {% endif %}
+  {% endif %}
+
+
