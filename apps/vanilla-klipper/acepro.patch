+
+[lis2dw12]
+spi_speed: 1000000
+cs_pin: nozzle_mcu:PB12
+spi_software_sclk_pin:nozzle_mcu:PB13
+spi_software_mosi_pin:nozzle_mcu:PB15
+spi_software_miso_pin:nozzle_mcu:PB14
+rate:400
+axes_map:x,y,z
+
+[lis2dw12 bed]
+spi_speed: 1000000
+cs_pin: PA15
+spi_software_sclk_pin:PC10
+spi_software_mosi_pin:PC12
+spi_software_miso_pin:PC11
+rate:400
+axes_map: y,x,z
+
+[resonance_tester]
+accel_chip_x: lis2dw12
+accel_chip_y: lis2dw12 bed
+probe_points:127, 127, 20
+min_freq: 10
+max_freq: 100
+accel_per_hz: 150
+hz_per_sec:2
+#test_freq_start: 70
+#test_freq_end: 80
+
+[pause_resume]
+#pause_position: 278,240
+#z_up: 10
+#bee_path: /sys/class/pwm/pwmchip0/pwm0/enable
+
+
+[cs1237]
+level_pin:nozzle_mcu:PA7
+dout_pin:nozzle_mcu:PA6
+sclk_pin:nozzle_mcu:PA5
+register:60
+sensitivity: -3000
+head_block_sensitivity:-300000
+scratch_sensitivity:-100000
+self_check_sensitivity:-400
+block_filament_sensitivity:-3000
+
+[gcode_arcs]
+resolution:1.0
+
+[input_shaper]
+#shaper_freq_x: 60.0
+#shaper_freq_y: 60.0
+#shaper_type_x: mzv
+#shaper_type_y: mzv
+
+
+[gcode_macro SHAKE_NOZZLE_HORIZONTAL]
+description: "Shake nozzle left/right to remove purged filament"
+# Optional parameters:
+#   AMP: amplitude of shake in mm
+#   COUNT: number of shake cycles
+#   SPEED: feedrate for shaking in mm/min
+gcode:
+    {% set AMP = params.AMP|default(40)|float %}
+    {% set COUNT = params.COUNT|default(3)|int %}
+    {% set SPEED = params.SPEED|default(12000)|float %}
+    {% set AMP_NEG = 0 - AMP %}
+
+    SAVE_GCODE_STATE NAME=shake_nozzle_state
+
+    G91
+    VEL_PUSH
+    SET_VELOCITY_LIMIT ACCEL=15000 ACCEL_TO_DECEL=5000 VELOCITY=300
+    {% for i in range(COUNT) %}
+        G1 X{AMP} F{SPEED}
+        G1 X{AMP_NEG} F{SPEED}
+    {% endfor %}
+
+    G90
+    VEL_POP
+    RESTORE_GCODE_STATE NAME=shake_nozzle_state
+    
+[gcode_macro NOZZLE_WIPE_SEQUENCE]
+gcode:
+    SAVE_GCODE_STATE NAME=wipe_nozzle_state
+    VEL_PUSH
+    SET_VELOCITY_LIMIT ACCEL=15000 ACCEL_TO_DECEL=5000 VELOCITY=300
+    G90
+    G1 X46 Y260 Z3 F9600
+    G1 X46 Y260 Z-0.8 F9600
+    G1 X50 Y260 Z1 F9600
+    G1 X86 Y260 Z1 F9600
+    G1 X90 Y260 Z-0.8 F9600
+    G1 X90 Y259 Z-0.8 F9600
+    G1 X86 Y259 Z1 F9600
+    G1 X50 Y259 Z1 F9600
+    G1 X46 Y259 Z-0.8 F9600
+    M400
+    G1 X70 Y260 Z0.2 F9600
+    SHAKE_NOZZLE_HORIZONTAL
+    G1 X70 Y260 Z3 F9600
+    M400
+    VEL_POP
+    G90
+    G1 Z4 F600
+    M400
+    
+    RESTORE_GCODE_STATE NAME=wipe_nozzle_state MOVE=1 MOVE_SPEED=200
+
+[gcode_macro RESUME_NOZZLE_WIPE_SEQUENCE]
+gcode:
+    TO_THROW_POSITION SPEED=2000
+    TO_THROW_POSITION
+
+[gcode_macro MOVE_FLUSH_POS]
+gcode:
+    G90
+    G1 X278 F9600
+
+
+[gcode_macro TO_THROW_POSITION]
+gcode:
+    {% set speed = params.SPEED|default(12000)|float %}
+    G90
+    G1 X250 F{speed}
+    MOVE_FLUSH_POS
+
+
+[gcode_macro CUT_TIP]
+gcode:
+    {% set min_temp = printer.configfile.settings.extruder.min_extrude_temp|int %}
+    {% set current_temp = printer.extruder.temperature|float %}
+
+    # Home all axes if not already homed — required for XYZ cutter moves
+    {% if 'xyz' not in printer.toolhead.homed_axes %}
+        { action_respond_info("ACE[M]: Axes not homed — homing before cut") }
+        G28
+    {% endif %}
+
+    { action_respond_info("ACE[M]: Cut pre...") }
+  
+    # Check if we need to heat
+    {% if current_temp > min_temp %}
+      G1 E-2 F300 # Avoid oozing if nozzle is already hot    
+    {% endif %}
+  
+    
+    { action_respond_info("ACE[M]: Cutting...") }
+    G91
+    G1 Z4 F4800
+    G90
+    G1 Y260 F9600
+    G91
+    G1 Z-4 F4800
+    G90
+    G1 X0 F12000
+    M400
+    G1 X-16 F600
+    M400
+    FORCE_MOVE STEPPER=extruder DISTANCE=-2 VELOCITY=10
+    FORCE_MOVE STEPPER=extruder DISTANCE=2 VELOCITY=10
+    FORCE_MOVE STEPPER=extruder DISTANCE=-2 VELOCITY=10 
+    G1 X0 F6000
+    MOVE_FLUSH_POS
+    M400
+    FORCE_MOVE STEPPER=extruder DISTANCE=2 VELOCITY=10
+    M400
+    
+    { action_respond_info("ACE[M]: Cut done...") }
+
+[gcode_macro MOVE_HEAT_POS]
+gcode:
+    G90
+    G1 X278 F9600
+   
+
+[gcode_macro UNDERLINE]
+gcode:
+    G90
+    G92 E0
+    G1 E-1 F300
+    G1 Y4 F2400
+    G1 X10 F9600
+    G1 Z0.28
+    G1 E1 F300
+    G1 X180 E40 F500
+    M400
+    G92 E0
+    G1 E-0.5 F300
+    G1 Z2
+    M400
+
+[gcode_macro MOVE_END_POS]
+gcode:
+    G90
+    G1 X5 Y242.25 F9600
+    M400
+
+[display_status]
+
+
+[gcode_macro nozzle_light_on]
+  gcode:
+      SET_PIN PIN=nozzle_light VALUE=1
+
+[gcode_macro nozzle_light_off]
+  gcode:
+      SET_PIN PIN=nozzle_light VALUE=0
+
+[gcode_macro logo_light_on]
+  gcode:
+      SET_PIN PIN=logo_light VALUE=1
+
+[gcode_macro logo_light_off]
+  gcode:
+      SET_PIN PIN=logo_light VALUE=0
+
+
+[gcode_macro lights_off]
+gcode:
+    logo_light_off
+    nozzle_light_off
+    
+[gcode_macro nozzle_light_toggle]
+gcode:
+    {% if printer["output_pin nozzle_light"].value == 0 %}
+        nozzle_light_on
+    {% else %}
+        nozzle_light_off
+    {% endif %}
+
+[gcode_macro logo_light_toggle]
+gcode:
+    {% if printer["output_pin logo_light"].value == 0 %}
+        logo_light_on
+    {% else %}
+        logo_light_off
+    {% endif %}
+
+
+[gcode_macro CANCEL_PRINT]
+description: CANCEL_PRINT
+rename_existing: CANCEL_PRINT_BASE
+gcode:
+    #In case resume was called from CANCEL PROMPT, close the prompt
+    RESPOND TYPE=command MSG=action:prompt_end
+
+    # Clear Power Loss Recovery state to prevent false prompts on restart, if PLR is installed
+    {% if "gcode_macro clear_last_file" in printer %}
+        clear_last_file
+    {% endif %}
+
+    {action_respond_info("ACE[M]: CANCEL_PRINT, lifting Z")}
+    G91
+    G1 Z3 F600
+    G90
+
+    {% if printer["output_pin ACE_Pro"] is defined and printer["output_pin ACE_Pro"].value %}
+        _ACE_HANDLE_PRINT_END
+    {% else %}
+        {action_respond_info("ACE[M]: ACE Pro disabled. Normal cut sequence")}
+        CUT_TIP
+        FORCE_MOVE STEPPER=extruder DISTANCE=-50 VELOCITY=8
+    {% endif %}
+    MOVE_FLUSH_POS
+
+    M104 S0
+    M140 S0 ; turn off heatbed
+    M106 S0 ; fan off
+    M84 # Disable steppers
+    lights_off
+
+    CANCEL_PRINT_BASE
+
+[gcode_macro PRINT_END]
+description: PRINT_END
+gcode:
+    {% set _cut_raw = (params.CUT_TIP | default(params.cut_tip) | default("1")) | string %}
+    {% set _cut_raw = (_cut_raw | trim | replace('=', '', 1) | lower) %}
+    {% set do_cut = (1 if _cut_raw in ['1','true','yes','on'] else 0) %}
+
+    # Clear Power Loss Recovery state to prevent false prompts on next restart
+    {% if "gcode_macro clear_last_file" in printer %}
+        clear_last_file
+    {% endif %}
+    
+    {action_respond_info("PRINT_END, lifting z")}
+    G91
+    G1 Z3 F600
+    G90
+        {% if printer["output_pin ACE_Pro"] is defined and printer["output_pin ACE_Pro"].value %}
+            _ACE_HANDLE_PRINT_END CUT_TIP={do_cut}
+        {% endif %}
+    
+    # Note: CUT_TIP and filament retraction is handled by _ACE_HANDLE_PRINT_END
+    # Only do manual cut/retract if ACE is disabled
+    {% if not (printer["output_pin ACE_Pro"] is defined and printer["output_pin ACE_Pro"].value) %}
+        {% if do_cut %}
+            {action_respond_info("Cutting filament")}
+            CUT_TIP
+            TO_THROW_POSITION
+            {action_respond_info("Retracting filament")}
+            FORCE_MOVE STEPPER=extruder DISTANCE=-50 VELOCITY=8
+        {% else %}
+            {action_respond_info("Skipping CUT_TIP")}
+            TO_THROW_POSITION
+        {% endif %}
+    {% else %}
+        # ACE handled the cut/retract, just move to throw position
+        TO_THROW_POSITION
+    {% endif %}
+
+    M104 S0
+    M140 S0 ; turn off heatbed
+    M106 S0 ; fan off
+    M84 # Disable steppers
+    lights_off
+
+# =======================
+# G9111 — Startup Macro for Anycubic slicer compatibility
+# =======================
+[gcode_macro G9111]
+description: "Startup: G9111 BEDTEMP=<°C> EXTRUDERTEMP=<°C> [WIPETEMP=<°C>] [TOOL=<initial tool index>] [SKIP_PURGE_FOR_ALREADY_LOADED_TOOL=0|1] (TOOL required only when ACE Pro is active)"
+variable_travel_speed: 200  # mm/s
+variable_wipe_temp: 170
+gcode:
+  # Helper: strip one leading '=' if present, then float
+  {% set bed_raw = (params.BEDTEMP | default(params.S) | default("60")) | string %}
+  {% set noz_raw = (params.EXTRUDERTEMP | default(params.T) | default("200")) | string %}
+  {% set wipe_raw = (params.WIPETEMP | default(printer["gcode_macro G9111"].wipe_temp) | string) %}
+  {% set ace_pin_defined = printer["output_pin ACE_Pro"] is defined %}
+  {% set ace_pin_enabled = (ace_pin_defined and (printer["output_pin ACE_Pro"].value | float > 0.5)) %}
+  {% set has_tool_param = ('TOOL' in params) or ('tool' in params) %}
+  {% if ace_pin_enabled and not has_tool_param %}
+    { action_raise_error("G9111: Missing required TOOL parameter. Use TOOL=[initial_tool]") }
+  {% endif %}
+  {% if has_tool_param %}
+    {% set TOOL = ((params.TOOL | default(params.tool) | string | replace('=', '', 1)) | int) %}
+  {% else %}
+    {% set current_extruder = printer.toolhead.extruder %}
+    {% set tool_num = current_extruder | replace('extruder','') %}
+    {% set tool_num = tool_num if tool_num|length > 0 else '0' %}
+    {% set TOOL = tool_num | int %}
+    { action_respond_info("G9111: TOOL not passed and ACE Pro is disabled - using active tool T%d" % TOOL) }
+  {% endif %}
+  {% if TOOL < 0 %}
+    { action_raise_error("G9111: Invalid TOOL=%d. TOOL must be >= 0." % TOOL) }
+  {% endif %}
+  {% set _skip_raw =
+      (params.SKIP_PURGE_FOR_ALREADY_LOADED_TOOL
+       | default(params.skip_purge_for_already_loaded_tool)
+       | default("0")) | string
+  %}
+  {% set _skip_raw = (_skip_raw | trim | replace('=', '', 1) | lower) %}
+  {% set SKIP_PURGE_FOR_ALREADY_LOADED_TOOL = (1 if _skip_raw in ['1','true','yes','on'] else 0) %}
+
+  {% set BEDTEMP = (bed_raw | replace('=', '', 1)) | float %}
+  {% set EXTRUDERTEMP = (noz_raw | replace('=', '', 1)) | float %}
+  {% set WIPETEMP = (wipe_raw | replace('=', '', 1)) | float %}
+
+  {% set f_travel = (printer["gcode_macro G9111"].travel_speed | float) * 60 %}
+
+  { action_respond_info(
+      "G9111: bed=%.1f°C, wipe=%.1f°C, final nozzle=%.1f°C, travel_speed=%.1f tool=%d"
+      % (BEDTEMP, WIPETEMP, EXTRUDERTEMP, f_travel, TOOL)
+    ) }
+
+
+  # --- Set startup_toolchange flag ---
+  {% if printer["gcode_macro _ACE_STATE"] is defined %}
+    SET_GCODE_VARIABLE MACRO=_ACE_STATE VARIABLE=startup_toolchange VALUE=1
+  {% endif %}
+
+  {% set local_skip_purge = False %}
+
+  {% if SKIP_PURGE_FOR_ALREADY_LOADED_TOOL %}
+    # --- SMART LOGIC START ---
+
+    # Safety check: Does save_variables exist? (Important for non-ACE users)
+    {% if printer.save_variables is defined and printer.save_variables.variables is defined %}
+        {% set ace_index = printer.save_variables.variables.ace_current_index|default(-1)|int %}
+        {% set filament_pos = printer.save_variables.variables.ace_filament_pos|default('none') %}
+    {% else %}
+        # Fallback if save_variables is missing -> Force Purge
+        {% set ace_index = -1 %}
+        {% set filament_pos = 'none' %}
+    {% endif %}
+
+    # What does the sensor actually see?
+    {% set is_physically_loaded = False %}
+    {% if "filament_switch_sensor filament_runout_nozzle" in printer.configfile.settings %}
+            {% set is_physically_loaded = printer["filament_switch_sensor filament_runout_nozzle"].filament_detected %}
+    {% endif %}
+
+    {% if TOOL == ace_index and filament_pos == 'nozzle' and is_physically_loaded %}
+        {% set local_skip_purge = True %}
+        { action_respond_info("G9111: Tool %d correctly loaded (Memory+Sensor). Purge SKIPPED." % TOOL) }
+    {% else %}
+        {% if not is_physically_loaded and TOOL == ace_index %}
+                { action_respond_info("G9111: Same Tool (%d), but sensor reports EMPTY. Purge ACTIVE." % TOOL) }
+        {% else %}
+                { action_respond_info("G9111: Tool change (%d -> %d). Purge ACTIVE." % (ace_index, TOOL)) }
+        {% endif %}
+    {% endif %}
+    # --- SMART LOGIC END ---
+  {% else %}
+    { action_respond_info("G9111: Smart logic disabled - Purge will always run") }
+  {% endif %}
+
+  logo_light_on
+  # Set temps
+  RESPOND TYPE=echo MSG="Nowait pre-heat for nozzle wipe"
+  M104 S{WIPETEMP}
+  M140 S{BEDTEMP}
+
+  RESPOND TYPE=echo MSG="Home"
+  G28
+
+  RESPOND TYPE=echo MSG="Wait for pre-heat temp reached"
+  MOVE_HEAT_POS
+  # Wait to wipe temp
+  M109 S{WIPETEMP}
+  RESPOND TYPE=echo MSG="Wipe nozzle"
+  NOZZLE_WIPE_SEQUENCE
+
+  RESPOND TYPE=echo MSG="Homing"
+  G90
+  G28 Z
+  M106 S255
+
+    # --- BED MESH LOGIC (Temperature Based) ---
+  {% set bed_int = BEDTEMP|int %}
+  {% set MESH_NAME = "BED_" ~ bed_int %}
+
+  {% if printer.bed_mesh.profiles[MESH_NAME] is defined %}
+      RESPOND TYPE=echo MSG="Bed mesh '{MESH_NAME}' found. Loading profile..."
+      BED_MESH_PROFILE LOAD={MESH_NAME}
+  {% else %}
+      RESPOND TYPE=echo MSG="Bed mesh '{MESH_NAME}' not found. Generating adaptive mesh..."
+      BED_MESH_CALIBRATE PROFILE=adaptive ADAPTIVE=1
+  {% endif %}
+
+
+  # Final nozzle temp (wait)
+  nozzle_light_on
+  RESPOND TYPE=echo MSG="Heat nozzle to print temperature"
+  M106 S0
+  MOVE_HEAT_POS
+  M109 S{EXTRUDERTEMP}
+
+  #Inform ace that this is initial startup toolchange. This avoids double wipping from this macro and the toolchange macro
+  {% if printer["gcode_macro _ACE_STATE"] is defined
+   and printer["gcode_macro _ACE_STATE"].startup_toolchange is defined %}
+    SET_GCODE_VARIABLE MACRO=_ACE_STATE VARIABLE=startup_toolchange VALUE=1
+  {% endif %}
+  
+  ; activate resolved tool (TOOL required only when ACE Pro is active)
+  RESPOND TYPE=echo MSG="Selecting passed active tool"
+  T{TOOL}
+  M400
+  
+  {% if not local_skip_purge %}
+    RESPOND TYPE=echo MSG="Prime nozzle"
+    G92 E0
+    G1 E80 F300
+    G1 E80 F150
+  {% else %}
+    RESPOND TYPE=echo MSG="ACE: Purge skipped"
+  {% endif %}
+
+  RESPOND TYPE=echo MSG="Wipe nozzle after purge"
+  NOZZLE_WIPE_SEQUENCE
+  
+  G92 E0
+  G1 E-1 F7000
+  G92 E0
+  
+  RESPOND TYPE=echo MSG="Purge line"
+  UNDERLINE
+
+  # --- Clear startup_toolchange flag ---
+  {% if printer["gcode_macro _ACE_STATE"] is defined %}
+    SET_GCODE_VARIABLE MACRO=_ACE_STATE VARIABLE=startup_toolchange VALUE=0
+  {% endif %}
+
+  RESPOND TYPE=echo MSG="G9111 complete."
+
+[gcode_macro FLUSH_POOP]
+description: Flush
+gcode:
+  M106 S255  
+  G4 P1000
+  G90
+  G1 X250 F9600
+  G4 P1000  
+  TO_THROW_POSITION  SPEED=2000
+  M106 S0
+  
diff --git a/printer_K3M.cfg b/printer_K3M.cfg
new file mode 100644
index 0000000..07aa376
--- /dev/null
+++ b/printer_K3M.cfg
@@ -0,0 +1,899 @@
+# Kobra 3 printer configuration
+# Requires (via include above): printer_generic_macros.cfg for PAUSE/RESUME scaffolding,
+# insert/runout prompt helpers, VEL_PUSH/POP, load/unload/purge helpers; ace_K3.cfg for
+# ACE-specific macros and optional _ACE_STATE/_ACE_HANDLE_PRINT_END.
+[include mainsail.cfg]
+[include printer_generic_macros.cfg]
+[include temperature_sensors.cfg]
+[exclude_object]
+[gcode_macro _CLIENT_VARIABLE]
+
+
+#variable_use_custom_pos   : False ; use custom park coordinates for x,y [True/False]
+#variable_custom_park_x    : 0.0   ; custom x position; value must be within your defined min and max of X
+#variable_custom_park_y    : 0.0   ; custom y position; value must be within your defined min and max of Y
+#variable_custom_park_dz   : 2.0   ; custom dz value; the value in mm to lift the nozzle when move to park position
+#variable_retract          : 1.0   ; the value to retract while PAUSE
+#variable_cancel_retract   : 5.0   ; the value to retract while CANCEL_PRINT
+#variable_speed_retract    : 35.0  ; retract speed in mm/s
+#variable_unretract        : 1.0   ; the value to unretract while RESUME
+#variable_speed_unretract  : 35.0  ; unretract speed in mm/s
+#variable_speed_hop        : 15.0  ; z move speed in mm/s
+#variable_speed_move       : 100.0 ; move speed in mm/s
+#variable_park_at_cancel   : False ; allow to move the toolhead to park while execute CANCEL_PRINT [True/False]
+#variable_park_at_cancel_x : None  ; different park position during CANCEL_PRINT [None/Position as Float]; park_at_cancel must be True
+#variable_park_at_cancel_y : None  ; different park position during CANCEL_PRINT [None/Position as Float]; park_at_cancel must be True
+## !!! Caution [firmware_retraction] must be defined in the printer.cfg if you set use_fw_retract: True !!!
+#variable_use_fw_retract   : False ; use fw_retraction instead of the manual version [True/False]
+#variable_idle_timeout     : 0     ; time in sec until idle_timeout kicks in. Value 0 means that no value will be set or restored
+#variable_runout_sensor    : ""    ; If a sensor is defined, it will be used to cancel the execution of RESUME in case no filament is detected.
+##                                   Specify the config name of the runout sensor e.g "filament_switch_sensor runout". Hint use the same as in your printer.cfg
+## !!! Custom macros, please use with care and review the section of the corresponding macro.
+## These macros are for simple operations like setting a status LED. Please make sure your macro does not interfere with the basic macro functions.
+## Only  single line commands are supported, please create a macro if you need more than one command.
+#variable_user_pause_macro : ""    ; Everything inside the "" will be executed after the klipper base pause (PAUSE_BASE) function
+#variable_user_resume_macro: ""    ; Everything inside the "" will be executed before the klipper base resume (RESUME_BASE) function
+#variable_user_cancel_macro: ""    ; Everything inside the "" will be executed before the klipper base cancel (CANCEL_PRINT_BASE) function
+gcode:
+
+[force_move]
+enable_force_move: True
+
+[filament_tracker filament_runout_nozzle]
+# K3M motion sensor (quadrature-like pulses):
+# - tracker_detect_pin and tracker_encoder_pin are the two phase-shifted channels
+# - no static filament-presence switch is available on this hardware
+tracker_detect_pin: !nozzle_mcu:PB0
+tracker_encoder_pin: !nozzle_mcu:PA1
+signal_type: gpio
+length_per_pulse: 1.86532063806894
+absence_timeout: 2
+pause_on_runout: False
+runout_gcode:
+    {% set ps = printer.print_stats.state|string %}
+    {% if ps in ["printing", "paused"] %}
+        MOVE_HEAT_POS
+        RESPOND TYPE=command MSG="action:prompt_begin Filament Runout"
+        RESPOND TYPE=command MSG="action:prompt_text Filament runout detected. Print is paused. Insert filament into the toolhead, it will be pulled in automatically."
+        RESPOND TYPE=command MSG="action:prompt_button Cancel Print|RUNOUT_CANCEL_PRINT"
+        RESPOND TYPE=command MSG="action:prompt_show"
+    {% else %}
+        { action_respond_info("ANY[m]: Runout ignored (state=%s)" % ps) }
+    {% endif %}
+insert_gcode:
+    RESPOND TYPE=command MSG=action:prompt_end
+    {% set ps = printer.print_stats.state|string %}
+    {% if ps == "paused" %}
+        M83
+        G92 E0
+        G1 E150 F300
+        G92 E0
+        FLUSH_POOP
+        RESPOND TYPE=command MSG="action:prompt_begin Filament Loaded"
+        RESPOND TYPE=command MSG="action:prompt_text Filament detected. Choose next action:"
+        RESPOND TYPE=command MSG="action:prompt_button Extrude 50mm|INSERT_EXTRUDE_50"
+        RESPOND TYPE=command MSG="action:prompt_button Resume Print|INSERT_RESUME_PRINT"
+        RESPOND TYPE=command MSG="action:prompt_button Cancel Print|INSERT_CANCEL_PRINT"
+        RESPOND TYPE=command MSG="action:prompt_show"
+    {% elif ps not in ["printing", "paused"] %}
+        RESPOND TYPE=command MSG="action:prompt_begin Filament Detected"
+        RESPOND TYPE=command MSG="action:prompt_text Filament detected while printer is idle. Load filament to nozzle?"
+        RESPOND TYPE=command MSG="action:prompt_button Load Filament (@245°C)|INSERT_LOAD_FILAMENT"
+        RESPOND TYPE=command MSG="action:prompt_button Dismiss|INSERT_DISMISS"
+        RESPOND TYPE=command MSG="action:prompt_show"
+    {% else %}
