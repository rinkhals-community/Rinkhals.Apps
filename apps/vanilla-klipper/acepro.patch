+# This file contains common configurations and pin mappings for the Anycubic KS1 printer.
+# Requires (via include above): printer_generic_macros.cfg for PAUSE/RESUME scaffolding,
+# insert/runout prompt helpers, VEL_PUSH/POP, load/unload/purge helpers; ace_KS1.cfg for
+# ACE-specific macros and optional _ACE_STATE/_ACE_HANDLE_PRINT_END.
+# See docs/Config_Reference.md for a description of parameters.
+[include mainsail.cfg]
+[include printer_generic_macros.cfg]
+
+######### Must be placed above ace.cfg if you want to use them with ACE Pro driver #########
+
+[filament_switch_sensor filament_runout_nozzle]
+pause_on_runout: True
+runout_gcode:
+    {% set ps = printer.print_stats.state|string %}
+    {% if ps in ["printing", "paused"] %}
+        TO_THROW_POSITION
+        RESPOND TYPE=command MSG="action:prompt_begin Filament Runout"
+        RESPOND TYPE=command MSG="action:prompt_text Filament runout detected. Print is paused. Insert filament into the toolhead, it will be pulled in automatically."
+        RESPOND TYPE=command MSG="action:prompt_button Cancel Print|RUNOUT_CANCEL_PRINT"
+        RESPOND TYPE=command MSG="action:prompt_show"
+    {% else %}
+        { action_respond_info("ANY[m]: Runout ignored (state=%s)" % ps) }
+    {% endif %}
+insert_gcode:
+    RESPOND TYPE=command MSG=action:prompt_end
+    {% set ps = printer.print_stats.state|string %}
+    {% if ps == "paused" %}
+        M83
+        G92 E0
+        G1 E150 F300
+        G92 E0
+        FLUSH_POOP
+        RESPOND TYPE=command MSG="action:prompt_begin Filament Loaded"
+        RESPOND TYPE=command MSG="action:prompt_text Filament detected. Choose next action:"
+        RESPOND TYPE=command MSG="action:prompt_button Extrude 50mm|INSERT_EXTRUDE_50"
+        RESPOND TYPE=command MSG="action:prompt_button Resume Print|INSERT_RESUME_PRINT"
+        RESPOND TYPE=command MSG="action:prompt_button Cancel Print|INSERT_CANCEL_PRINT"
+        RESPOND TYPE=command MSG="action:prompt_show"
+    {% elif ps not in ["printing", "paused"] %}
+        RESPOND TYPE=command MSG="action:prompt_begin Filament Detected"
+        RESPOND TYPE=command MSG="action:prompt_text Filament detected while printer is idle. Load filament to nozzle?"
+        RESPOND TYPE=command MSG="action:prompt_button Load Filament (@245°C)|INSERT_LOAD_FILAMENT"
+        RESPOND TYPE=command MSG="action:prompt_button Dismiss|INSERT_DISMISS"
+        RESPOND TYPE=command MSG="action:prompt_show"
+    {% endif %}
+event_delay: 3.0
+pause_delay: 0.5
+#debounce_delay:
+switch_pin: nozzle_mcu:PB0
+
+    
+# ACE Pro return detection module (on the back of KS1 printer)
+[filament_switch_sensor filament_runout_rdm]
+pause_on_runout: False  # Enable this only if ACE is used to feed filament
+switch_pin: PB0
+
+############# Alternative RDM sensor handling via filament_tracker, comment out above filament_switch_sensor if you want to use this #############
+# [filament_tracker filament_runout_rdm]
+# tracker_detect_pin: PB0
+# tracker_encoder_pin: PB1
+# signal_type: adc
+# safe_unwind_len: 150
+# length_per_pulse: 1.86532063806894
+# adc_inverted: True
+# detect_pin_is_switch: True
+# absence_timeout: 2
+# #debug_trace: True
+# pause_on_runout: True
+# runout_gcode:
+
+
+#[include spoolman_logic.cfg]  # has to be before ace.cfg
+[include ace_KS1.cfg]
+
+#[include timelapse.cfg]
+
+[gcode_macro _CLIENT_VARIABLE]
+variable_use_custom_pos   : True ; use custom park coordinates for x,y [True/False]
+variable_custom_park_x    : 48.0   ; custom x position; value must be within your defined min and max of X
+variable_custom_park_y    : 250.0   ; custom y position; value must be within your defined min and max of Y
+#variable_custom_park_dz   : 2.0   ; custom dz value; the value in mm to lift the nozzle when move to park position
+#variable_retract          : 1.0   ; the value to retract while PAUSE
+#variable_cancel_retract   : 5.0   ; the value to retract while CANCEL_PRINT
+#variable_speed_retract    : 35.0  ; retract speed in mm/s
+#variable_unretract        : 1.0   ; the value to unretract while RESUME
+#variable_speed_unretract  : 35.0  ; unretract speed in mm/s
+#variable_speed_hop        : 15.0  ; z move speed in mm/s
+#variable_speed_move       : 100.0 ; move speed in mm/s
+variable_park_at_cancel   : True ; allow to move the toolhead to park while execute CANCEL_PRINT [True/False]
+variable_park_at_cancel_x : 48.0   ; different park position during CANCEL_PRINT [None/Position as Float]; park_at_cancel must be True
+variable_park_at_cancel_y : 250.0  ; different park position during CANCEL_PRINT [None/Position as Float]; park_at_cancel must be True
+## !!! Caution [firmware_retraction] must be defined in the printer.cfg if you set use_fw_retract: True !!!
+#variable_use_fw_retract   : False ; use fw_retraction instead of the manual version [True/False]
+#variable_idle_timeout     : 0     ; time in sec until idle_timeout kicks in. Value 0 means that no value will be set or restored
+#variable_runout_sensor    : ""    ; If a sensor is defined, it will be used to cancel the execution of RESUME in case no filament is detected.
+##                                   Specify the config name of the runout sensor e.g "filament_switch_sensor runout". Hint use the same as in your printer.cfg
+## !!! Custom macros, please use with care and review the section of the corresponding macro.
+## These macros are for simple operations like setting a status LED. Please make sure your macro does not interfere with the basic macro functions.
+## Only  single line commands are supported, please create a macro if you need more than one command.
+#variable_user_pause_macro : ""    ; Everything inside the "" will be executed after the klipper base pause (PAUSE_BASE) function
+#variable_user_resume_macro: ""    ; Everything inside the "" will be executed before the klipper base resume (RESUME_BASE) function
+#variable_user_cancel_macro: ""    ; Everything inside the "" will be executed before the klipper base cancel (CANCEL_PRINT_BASE) function
+gcode:
+#Enable this only if you have a MCU build with MCU debug command support
+#[temperature_sensor mcu_temp]
+#sensor_type: temperature_mcu
+#sensor_mcu: mcu
+#min_temp: 0
+#max_temp: 100
+
+#[temperature_sensor mcu_nozzle_temp]
+#sensor_type: temperature_mcu
+#sensor_mcu: nozzle_mcu
+#min_temp: 0
+#max_temp: 100
+
+#For vanilla-klipper on SoC
+#[virtual_sdcard]
+#path: /useremain/app/gk/gcodes
+
+#[mcu]
+#serial : /dev/ttyS3
+#restart_method : command
+#baud : 576000
+
+#[mcu nozzle_mcu]
+#serial : /dev/ttyS5
+#restart_method : command
+#baud : 576000
+
+#######################
+#For tunneled-klipper:#
+#######################
+[virtual_sdcard]
+path: ~/printer_data/gcodes
+
+[mcu]
+serial : /dev/ttyGS0
+restart_method : command
+baud : 576000
+
+[mcu nozzle_mcu]
+serial : /dev/ttyGS1
+restart_method : command
+baud : 576000
+
+[printer]
+kinematics : corexy
+max_velocity:600
+max_accel:20000
+square_corner_velocity:15.0
+max_z_velocity:15
+max_z_accel:1000
+#jump_speed_min : 95
+#jump_speed_max : 120
+#device_type: Anycubic Kobra S1
+#print_size: 250*250*250mm
+
+
+
+[stepper_x]
+step_pin: PB12
+dir_pin: PA7
+enable_pin : !PC3
+microsteps : 16
+full_steps_per_rotation:200
+rotation_distance :40
+position_endstop : -6
+position_min : -6
+position_max : 265
+homing_speed : 30
+homing_retract_dist:0
+second_homing_speed:80
+#endstop_pin: tmc2209_stepper_x:virtual_endstop is also possible if you dont want/can use the x-endstop switch
+endstop_pin: !PA8
+#step_pulse_duration: 0.000002   # 2us
+
+[stepper_y]
+step_pin: PA5
+dir_pin: PA4
+enable_pin : !PC3
+microsteps : 16
+full_steps_per_rotation:200
+rotation_distance :40
+position_endstop : 0
+position_min : 0
+position_max : 277
+homing_speed : 30
+homing_retract_dist:0
+second_homing_speed:80
+endstop_pin: PA11   #tr5
+#step_pulse_duration: 0.000002   # 2us
+
+[cs1237]
+level_pin:nozzle_mcu:PA7
+dout_pin:nozzle_mcu:PA6
+sclk_pin:nozzle_mcu:PA5
+register:60
+sensitivity: -2500
+head_block_sensitivity:-300000
+scratch_sensitivity:-100000
+self_check_sensitivity:-400
+block_filament_sensitivity:-3000
+
+
+[probe_ks1]
+pin : PB15 #nozzle_mcu:PA4
+z_offset:0
+x_offset:0
+y_offset:0
+speed : 3.0
+final_speed : 4.0
+lift_speed : 3.0
+samples: 3
+sample_retract_dist: 3
+samples_result: median
+samples_tolerance: 0.04
+samples_tolerance_retries:20
+
+
+[bed_mesh]
+speed: 300
+horizontal_move_z:3
+mesh_min:5,5
+mesh_max:245,245
+probe_count:5,5
+mesh_pps: 2,2
+split_delta_z:0.0125
+algorithm: bicubic
+fade_start: 1
+fade_end: 10
+fade_target: 0
+# --- EXCLUSION ZONES does not probe in those areas---
+
+# 1. Dead Zone Rear Left (Frame/Clip)
+# Region: 0<=X<=25 and 253<=Y<=258
+faulty_region_1_min: 0.0, 253.0
+faulty_region_1_max: 25.0, 258.0
+
+# 2. Pin 1 (Middle Left)
+# Region: 70<=X<=76 and 254<=Y<=260
+faulty_region_2_min: 70.0, 254.0
+faulty_region_2_max: 76.0, 260.0
+
+# 3. Pin 2 (Right)
+# Region: 180<=X<=186 and 254<=Y<=260
+faulty_region_3_min: 180.0, 254.0
+faulty_region_3_max: 186.0, 260.0
+
+# 4. Dead Zone Rear Right
+# Region: 233<=X<=258 and 253<=Y<=258
+faulty_region_4_min: 233.0, 253.0
+faulty_region_4_max: 258.0, 258.0
+
+# 5. Cutter Corner (Front Right)
+# Region: 250x0 to 258x30
+faulty_region_5_min: 250.0, 0.0
+faulty_region_5_max: 258.0, 30.0
+
+[stepper_z]
+step_pin : PB14
+dir_pin : PB13
+enable_pin : !PC3
+microsteps : 16
+rotation_distance : 2.66666666666666666   #试产样机的配置
+full_steps_per_rotation:200
+endstop_pin : probe:z_virtual_endstop
+position_min : -4
+position_max : 253
+homing_speed: 6
+homing_retract_dist:4
+second_homing_speed:3
+#step_pulse_duration: 0.000002   # 2us
+
+[extruder]
+max_extrude_only_distance : 1200.0
+step_pin : nozzle_mcu:PA12
+dir_pin : !nozzle_mcu:PA11
+enable_pin : !nozzle_mcu:PC13
+microsteps : 16
+full_steps_per_rotation:200
+rotation_distance :6.5756
+nozzle_diameter : 0.400
+filament_diameter : 1.750
+max_extrude_cross_section:50
+heater_pin : nozzle_mcu:PB8
+sensor_type : NTC ZM3486 HNS112HC4570G0060Y3486
+sensor_pin : nozzle_mcu:PA0
+control : pid
+pid_Kp : 17.393
+pid_Ki : 0.698
+pid_Kd : 108.268
+min_temp : -180
+min_extrude_temp : 170
+max_temp : 340
+pressure_advance: 0.03
+
+[heater_bed]
+heater_pin : PA0
